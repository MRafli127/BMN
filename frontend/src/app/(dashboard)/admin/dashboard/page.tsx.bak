  onUbahTerbuka: (o: boolean) => void;
  kodeSatker: string;
  label: string;
  onPilih: (tujuan: string) => void;
  counts: {
    menunggu: number;
    disetujui: number;
    dipinjam: number;
    dikembalikan: number;
    terlambat: number;
    ditolak: number;
    totalBarang: number;
    stokTersedia: number;
    stokHabis: number;
  } | null;
