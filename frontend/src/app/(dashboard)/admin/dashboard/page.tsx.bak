      shadow: 'shadow-primary/30',
      countKey: 'totalBarang' as const,
    },
    {
      label: 'Stok Tersedia',
      ikon: 'check_circle',
      gradient: 'from-green-400 to-emerald-600',
      shadow: 'shadow-green-500/30',
      countKey: 'stokTersedia' as const,
