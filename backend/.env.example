# ============================================================
#  KONFIGURASI BACKEND SIPP-BMN
#  Salin file ini menjadi ".env" lalu sesuaikan nilainya.
# ============================================================

# --- Server ---
NODE_ENV=development
PORT=5000
# URL frontend yang diizinkan mengakses API (untuk CORS)
CLIENT_URL=http://localhost:3000
# URL publik backend (dipakai untuk membentuk URL file upload, QR, dll.)
APP_URL=http://localhost:5000

# ============================================================
#  DATABASE (PostgreSQL) — pilih SALAH SATU opsi
# ============================================================

# --- Opsi 1: PostgreSQL lokal/native ---
# Format: postgresql://USER:PASSWORD@HOST:PORT/NAMA_DATABASE?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/sipp_bmn?schema=public"

# --- Opsi 2: Supabase (gratis) ---
# Dapatkan dari: Project Settings > Database > Connection string (URI)
# DATABASE_URL="postgresql://postgres.xxxxxxxx:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# --- Opsi 3: Neon (gratis) ---
# Dapatkan dari: Dashboard Neon > Connection Details
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# ============================================================
#  AUTENTIKASI (JWT)
#  Secret auto-generated saat pertama kali server dijalankan.
#  Sekali di-generate, nilainya tetap sampai di-reset manual.
# ============================================================
# Reset secrets: node -r ./src/config/env.js reset-secrets
# JWT_ACCESS_SECRET=
# JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ============================================================
#  UPLOAD FILE (Vercel Blob)
#  Di Vercel: tambahkan Blob Storage di dashboard, token otomatis tersedia.
#  Untuk lokal: salin token dari vercel.com > Storage > Blob > .env.local
# ============================================================
MAX_FILE_SIZE_MB=5
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxx

# ============================================================
#  AKUN ADMIN DEFAULT (dipakai oleh seeder)
# ============================================================
ADMIN_NAMA="Administrator BMN"
ADMIN_NIP="198001012010011001"
ADMIN_EMAIL="admin@bmn.go.id"
ADMIN_PASSWORD="Admin123!"
