// ============================================================
//  SKEMA DATABASE PRISMA — SIPP-BMN
//  Sistem Informasi Peminjaman & Pengembalian Barang Milik Negara
// ============================================================

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------
//  ENUM
// ------------------------------------------------------------

// Peran pengguna dalam sistem
enum Role {
  ADMIN
  PEMINJAM
}

// Jenis/kategori barang milik negara
enum JenisBarang {
  ELEKTRONIK
  FURNITUR
  KENDARAAN
  ATK
  LAINNYA
}

// Kondisi fisik barang
enum KondisiBarang {
  BAIK
  RUSAK_RINGAN
  RUSAK_BERAT
}

// Status alur peminjaman
enum StatusPeminjaman {
  MENUNGGU // Pengajuan baru, menunggu persetujuan admin
  DISETUJUI // Disetujui admin, barang siap diambil
  DITOLAK // Ditolak admin
  DIPINJAM // Barang sedang dipinjam
  DIKEMBALIKAN // Barang sudah dikembalikan
  TERLAMBAT // Melewati tanggal rencana kembali
  DRAFT // Pengajuan tersimpan ke Riwayat, surat pernyataan belum diunggah (belum terlihat admin). Barang tetap dikunci.
}

// Status tiap item barang pada satu peminjaman
enum StatusItem {
  DIPINJAM
  DIKEMBALIKAN
}

// Asal data barang: input manual oleh admin atau hasil import Excel
enum SumberBarang {
  MANUAL
  IMPORT
}

// Asal akun peminjam: dibuat manual (admin/registrasi) atau hasil import Excel.
// Hanya akun ber-sumber IMPORT yang ikut disinkronkan (perbarui/hapus) saat re-import.
enum SumberAkun {
  MANUAL
  IMPORT
}

// Prioritas notifikasi
enum PrioritasNotifikasi {
  TINGGI
  SEDANG
  RENDAH
}

// ------------------------------------------------------------
//  MODEL
// ------------------------------------------------------------

// 0) Token Blacklist — untuk invalidate refresh token saat logout
model BlacklistedToken {
  id        String   @id @default(uuid())
  token     String   @unique // Token yang di-blacklist
  expiresAt DateTime // kapan token ini expire (untuk auto-cleanup)
  userId    String?  // User yang logout (opsional, untuk tracking)
  createdAt DateTime @default(now())

  @@index([token])
  @@index([expiresAt])
  @@map("blacklisted_tokens")
}

// 1) Pengguna sistem (admin & peminjam)
model User {
  id        String     @id @default(uuid())
  nama      String
  nip       String     @unique // Nomor Induk Pegawai (unik)
  email     String     @unique
  password  String // Disimpan dalam bentuk hash bcrypt
  jabatan   String? // "Jabatan" pegawai / fungsional (diisi manual/import)
  unitKerja String? // "Unit Kerja" pegawai (diisi manual/import)
  eselon2   String? // "Eselon II" (diisi manual/import)
  eselon3   String? // "Eselon III" (diisi manual/import)
  eselon4   String? // "Eselon IV" (diisi manual/import)
  role      Role       @default(PEMINJAM)
  sumber    SumberAkun @default(MANUAL) // MANUAL (admin/registrasi) atau IMPORT (sinkron Excel)
  tokenVersion Int      @default(1) // Increment saat password diubah untuk invalidate semua token
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  // Relasi: peminjaman yang diajukan oleh user ini
  peminjaman  Peminjaman[] @relation("PeminjamanOlehPeminjam")
  // Relasi: peminjaman yang disetujui oleh user ini (sebagai admin)
  persetujuan Peminjaman[] @relation("PeminjamanDisetujuiAdmin")
  // Relasi: notifikasi yang diterima user ini
  notifikasi  Notifikasi[]

  @@map("users")
}

// 2) Barang Milik Negara
model Barang {
  id                String        @id @default(uuid())
  kodeBarang        String        @unique // Kode unik = kunci natural aset: Kode Satker-Kode Barang-NUP (mis. 015110199411868000KP-3100102002-1180)
  nama              String
  merk              String? // Merk/model barang (mis. Asus Notebook ROG)
  jenis             JenisBarang   @default(LAINNYA)
  jumlahTotal       Int           @default(0)
  jumlahTersedia    Int           @default(0)
  kondisi           KondisiBarang @default(BAIK)
  lokasiPenyimpanan String?
  deskripsi         String?
  fotoUrl           String?
  sumber            SumberBarang  @default(MANUAL) // Asal data: input MANUAL atau hasil IMPORT

  // --- Identitas aset register BMN (terisi untuk barang hasil import) ---
  // Kombinasi (kodeSatker, kodeBarangBmn, nup) menjadi kunci natural untuk
  // mencocokkan baris saat re-import (sinkronisasi tambah/perbarui/hapus).
  kodeSatker    String? // Kode Satker pada file BMN
  namaSatker    String? // Nama Satker pada file BMN
  kodeBarangBmn String? // "Kode Barang" asli pada file BMN (mis. 3100102002)
  nup           String? // Nomor Urut Pendaftaran (unik per satker+kode)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relasi: detail peminjaman yang memuat barang ini
  detailPeminjaman DetailPeminjaman[]

  // Kunci natural aset BMN. Row manual (semua null) tidak saling bentrok
  // karena NULL dianggap distinct oleh PostgreSQL.
  @@unique([kodeSatker, kodeBarangBmn, nup], name: "identitasAset")
  @@map("barang")
}

// 3) Peminjaman (transaksi pengajuan peminjaman)
model Peminjaman {
  id                    String           @id @default(uuid())
  kodeTransaksi         String?          @unique // Kode unik per transaksi (untuk QR scan & referensi). Format: BMN-YYYYMMDD-XXXXX. Nullable untuk kompatibilitas data lama.
  kodePeminjaman        String // Snapshot kode aset barang saat dipinjam. Saat dibaca, kode di-resync dari kodeBarang barang terkait (kunci natural kodeSatker-kodeBarangBmn-NUP).
  userId                String
  tanggalPengajuan      DateTime         @default(now())
  tanggalPinjamRencana  DateTime?
  tanggalKembaliRencana DateTime?
  tanggalKembaliAktual  DateTime?
  tanggalPermintaanKembali DateTime? // Saat peminjam mengajukan pengembalian; menunggu konfirmasi admin
  status                StatusPeminjaman @default(MENUNGGU)
  alasanPeminjaman      String?
  pangkatGolongan       String? // Pangkat/Gol. peminjam saat pengajuan (tercantum pada Surat Pernyataan). Disimpan agar surat draft bisa diunduh menyusul.
  dokumenUrl            String? // Dokumen yang diunggah peminjam
  dokumenStempelUrl     String? // Dokumen yang sudah distempel admin
  dokumenPengembalianUrl String? // Surat Pernyataan Pengembalian (PDF) yang sudah ditandatangani fisik & diunggah peminjam
  qrCodeUrl             String? // Gambar QR Code peminjaman
  catatanAdmin          String? // Catatan admin (wajib saat menolak). Terlihat oleh peminjam.
  catatanPengembalian   String? // Catatan admin saat konfirmasi pengembalian. HANYA untuk admin, tidak terlihat oleh peminjam.
  disetujuiOleh         String? // userId admin yang menyetujui
  nomorSurat            Int? // Nomor urut surat pernyataan (PRN-<nomorSurat>/BMN/PP.1/<tahunSurat>). Diberikan otomatis & berurut per tahun saat pengajuan dibuat, reset ke 1 tiap ganti tahun.
  tahunSurat            Int? // Tahun penomoran surat (dipakai bersama nomorSurat). Surat pengembalian memakai nomor & tahun yang sama.
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  // Relasi
  peminjam User               @relation("PeminjamanOlehPeminjam", fields: [userId], references: [id])
  admin    User?              @relation("PeminjamanDisetujuiAdmin", fields: [disetujuiOleh], references: [id])
  detail   DetailPeminjaman[]

  @@index([userId])
  @@index([status])
  @@index([kodePeminjaman])
  @@map("peminjaman")
}

// 4) Detail peminjaman — relasi banyak-ke-banyak Barang <-> Peminjaman
model DetailPeminjaman {
  id           String     @id @default(uuid())
  peminjamanId String
  barangId     String
  jumlahPinjam Int        @default(1)
  statusItem   StatusItem @default(DIPINJAM)

  peminjaman Peminjaman @relation(fields: [peminjamanId], references: [id], onDelete: Cascade)
  barang     Barang     @relation(fields: [barangId], references: [id])

  @@index([peminjamanId])
  @@index([barangId])
  @@map("detail_peminjaman")
}

// 4b) Penomoran surat — pencacah berurut per (jenis, tahun).
// Dipakai untuk menghasilkan nomor surat pernyataan yang berurut & unik
// (PRN-1, PRN-2, dst.) dan otomatis RESET ke 1 setiap ganti tahun (baris
// baru per tahun). Increment dilakukan atomik (INSERT ... ON CONFLICT)
// agar aman dari race condition saat banyak pengajuan bersamaan.
model NomorSuratCounter {
  id     String @id @default(uuid())
  jenis  String // Jenis surat, mis. "PEMINJAMAN"
  tahun  Int // Tahun penomoran (nomor reset tiap tahun)
  urutan Int    @default(0) // Nomor terakhir yang sudah dipakai untuk (jenis, tahun) ini

  @@unique([jenis, tahun])
  @@map("nomor_surat_counter")
}

// 5) Audit Log — untuk tracking semua perubahan data (CRUD, status change, login)
model AuditLog {
  id        String   @id @default(uuid())
  userId    String?  // User yang melakukan aksi (null untuk sistem)
  userEmail String?  // Snapshot email (jika user dihapus tetap bisa lihat)
  userNama  String?  // Snapshot nama
  aksi      String   // CREATE, UPDATE, DELETE, STATUS_CHANGE, LOGIN, LOGOUT, dll
  entitas   String   // Nama tabel/entity (peminjaman, barang, user, auth)
  entitasId String?  // ID record yang berubah (null untuk login/logout)
  dataLama  Json?    // Data sebelum perubahan (UPDATE/DELETE)
  dataBaru  Json?    // Data setelah perubahan (CREATE/UPDATE)
  ipAddress String?  // Alamat IP client
  userAgent String?  // User agent browser
  timestamp DateTime @default(now())

  @@index([userId])
  @@index([entitas])
  @@index([entitasId])
  @@index([aksi])
  @@index([timestamp])
  @@map("audit_logs")
}

// 6) Notifikasi — untuk menampilkan notifikasi kepada pengguna
model Notifikasi {
  id            String            @id @default(uuid())
  userId        String            // Pengguna yang menerima notifikasi
  tipe          String            // Jenis notifikasi: PEMINJAMAN_BARU, PEMINJAMAN_DISETUJUI, PEMINJAMAN_DITOLAK, PENGEMBALIAN, TERLAMBAT, dll
  judul         String            // Judul notifikasi
  pesan         String            // Isi pesan notifikasi
  prioritas    PrioritasNotifikasi @default(SEDANG)
  isBaca        Boolean           @default(false) // Apakah sudah dibaca
  referenceId   String?           // ID referensi (mis. peminjamanId)
  referenceType String?           // Tipe referensi (mis. PEMINJAMAN)
  createdAt     DateTime          @default(now())

  // Relasi ke user
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isBaca])
  @@index([createdAt])
  @@map("notifikasi")
}
