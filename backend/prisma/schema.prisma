generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Satker {
  id        String   @id @default(uuid())
  kode      String   @unique
  nama      String
  singkat   String?
  aktif     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("satker")
}

model BlacklistedToken {
  id        String   @id @default(uuid())
  token     String   @unique
  expiresAt DateTime
  userId    String?
  createdAt DateTime @default(now())

  @@index([token])
  @@index([expiresAt])
  @@map("blacklisted_tokens")
}

model User {
  id                   String       @id @default(uuid())
  nama                 String
  nip                  String       @unique
  email                String       @unique
  password             String
  jabatan              String?
  unitKerja            String?
  eselon2              String?
  eselon3              String?
  eselon4              String?
  roles                Role[]       @default([PEMINJAM])
  sumber               SumberAkun   @default(MANUAL)
  tokenVersion         Int          @default(1)
  retirementDate       DateTime?
  lastActivityAt       DateTime?
  sessionInvalidatedAt DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  satkerAkses          String[]     @default([])
  notifikasi           Notifikasi[]
  pengembalian         Peminjaman[] @relation("PeminjamanDikembalikanAdmin")
  persetujuan          Peminjaman[] @relation("PeminjamanDisetujuiAdmin")
  peminjaman           Peminjaman[] @relation("PeminjamanOlehPeminjam")

  @@map("users")
}

model Barang {
  id                String             @id @default(uuid())
  kodeBarang        String             @unique
  nama              String
  merk              String?
  jenis             JenisBarang        @default(LAINNYA)
  jumlahTotal       Int                @default(0)
  jumlahTersedia    Int                @default(0)
  kondisi           KondisiBarang      @default(BAIK)
  lokasiPenyimpanan String?
  deskripsi         String?
  fotoUrl           String?
  sumber            SumberBarang       @default(MANUAL)
  kodeSatker        String?
  namaSatker        String?
  kodeBarangBmn     String?
  nup               String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  detailPeminjaman  DetailPeminjaman[]

  @@unique([kodeSatker, kodeBarangBmn, nup], name: "identitasAset")
  @@map("barang")
}

model Peminjaman {
  id                       String             @id @default(uuid())
  kodeTransaksi            String?            @unique
  kodePeminjaman           String
  userId                   String
  tanggalPengajuan         DateTime           @default(now())
  tanggalKirim             DateTime?
  tanggalPinjamRencana     DateTime?
  tanggalKembaliRencana    DateTime?
  tanggalKembaliAktual     DateTime?
  tanggalPermintaanKembali DateTime?
  status                   StatusPeminjaman   @default(MENUNGGU)
  alasanPeminjaman         String?
  pangkatGolongan          String?
  dokumenUrl               String?
  dokumenStempelUrl        String?
  dokumenPengembalianUrl   String?
  qrCodeUrl                String?
  catatanAdmin             String?
  catatanPengembalian      String?
  disetujuiOleh            String?
  dikembalikanOleh         String?
  nomorSurat               Int?
  tahunSurat               Int?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
  detail                   DetailPeminjaman[]
  pengembalianAdmin        User?              @relation("PeminjamanDikembalikanAdmin", fields: [dikembalikanOleh], references: [id])
  admin                    User?              @relation("PeminjamanDisetujuiAdmin", fields: [disetujuiOleh], references: [id])
  peminjam                 User               @relation("PeminjamanOlehPeminjam", fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([kodePeminjaman])
  @@map("peminjaman")
}

model DetailPeminjaman {
  id           String     @id @default(uuid())
  peminjamanId String
  barangId     String
  jumlahPinjam Int        @default(1)
  statusItem   StatusItem @default(DIPINJAM)
  barang       Barang     @relation(fields: [barangId], references: [id])
  peminjaman   Peminjaman @relation(fields: [peminjamanId], references: [id], onDelete: Cascade)

  @@index([peminjamanId])
  @@index([barangId])
  @@map("detail_peminjaman")
}

model NomorSuratCounter {
  id     String @id @default(uuid())
  jenis  String
  tahun  Int
  urutan Int    @default(0)

  @@unique([jenis, tahun])
  @@map("nomor_surat_counter")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  userEmail String?
  userNama  String?
  aksi      String
  entitas   String
  entitasId String?
  dataLama  Json?
  dataBaru  Json?
  ipAddress String?
  userAgent String?
  timestamp DateTime @default(now())

  @@index([userId])
  @@index([entitas])
  @@index([entitasId])
  @@index([aksi])
  @@index([timestamp])
  @@map("audit_logs")
}

model Notifikasi {
  id            String              @id @default(uuid())
  userId        String
  tipe          String
  judul         String
  pesan         String
  prioritas     PrioritasNotifikasi @default(SEDANG)
  isBaca        Boolean             @default(false)
  referenceId   String?
  referenceType String?
  createdAt     DateTime            @default(now())
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isBaca])
  @@index([createdAt])
  @@map("notifikasi")
}

model ImportLog {
  id                         String   @id @default(uuid())
  userId                     String
  userEmail                  String
  userNama                   String
  jenisImport                String
  namaFile                   String
  jumlahBaris                Int
  akunDitambahkan            Int      @default(0)
  akunDiperbarui             Int      @default(0)
  peminjamanDibuat           Int      @default(0)
  peminjamanDipertahankan    Int      @default(0)
  dilewatiTanpaNup           Int      @default(0)
  gagal                      Int      @default(0)
  barangTidakDitemukan       Int      @default(0)
  detailDitambahkan          Json?
  detailDiperbarui           Json?
  detailPeminjaman           Json?
  detailGagal                Json?
  detailBarangTidakDitemukan Json?
  createdAt                  DateTime @default(now())

  @@index([userId])
  @@index([jenisImport])
  @@index([createdAt])
  @@map("import_logs")
}

enum Role {
  ADMIN
  PEMINJAM
  SUPER_ADMIN
}

enum JenisBarang {
  ELEKTRONIK
  FURNITUR
  KENDARAAN
  ATK
  LAINNYA
}

enum KondisiBarang {
  BAIK
  RUSAK_RINGAN
  RUSAK_BERAT
}

enum StatusPeminjaman {
  MENUNGGU
  DISETUJUI
  DITOLAK
  DIPINJAM
  DIKEMBALIKAN
  TERLAMBAT
  DRAFT
}

enum StatusItem {
  DIPINJAM
  DIKEMBALIKAN
}

enum SumberBarang {
  MANUAL
  IMPORT
}

enum SumberAkun {
  MANUAL
  IMPORT
}

enum PrioritasNotifikasi {
  TINGGI
  SEDANG
  RENDAH
}
